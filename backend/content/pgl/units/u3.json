{
  "slug": "u3-ymxc",
  "order_index": 3,
  "title": "Persamaan y = mx + c dan Makna c",
  "goal": "Mengenali c sebagai nilai awal dan menyusun model y = mx + c dari situasi.",
  "is_optional": false,
  "activities": [
    {
      "slug": "u3-jelajah",
      "phase": "explore",
      "title": "Apa yang dilakukan c?",
      "literacy_processes": [
        "reasoning",
        "interpret"
      ],
      "indicators": [
        "E3",
        "I1"
      ],
      "content": {
        "steps": [
          {
            "key": "pemantik",
            "type": "info",
            "title": "Nilai awal",
            "body": "Naik ojek: ada **biaya awal**, lalu ditambah **biaya per km**. Biaya per km adalah [[gradien]] $m$. Biaya awal adalah [[konstanta]] $c$.\n\nKita lihat apa yang dilakukan $c$ pada grafik."
          },
          {
            "key": "jelajah-c",
            "type": "explore",
            "title": "Jelajah",
            "mode": "single",
            "prompt": "Gradien dikunci $m = 1$. Geser slider $c$ ke atas dan ke bawah.",
            "initial": {
              "m": "1",
              "c": "0"
            },
            "lock_m": true,
            "question": {
              "prompt": "Saat $c$ diubah, apa yang terjadi?",
              "options": [
                {
                  "id": "a",
                  "text": "Garis bergeser naik/turun, kemiringannya tetap"
                },
                {
                  "id": "b",
                  "text": "Garis makin curam",
                  "feedback": "Bandingkan kemiringan sebelum dan sesudah c diubah."
                },
                {
                  "id": "c",
                  "text": "Garis berputar di titik (0, 0)"
                }
              ],
              "answer": "a"
            },
            "hints": [
              "Perhatikan di mana garis memotong sumbu-y.",
              "Apakah segitiga naik/jalan berubah?",
              "Titik potong sumbu-y selalu $(0, c)$."
            ],
            "solution": "$c$ menggeser garis naik/turun; garis memotong sumbu-y di $(0, c)$. Kemiringan tetap karena $m$ tidak berubah."
          },
          {
            "key": "potong-y",
            "type": "numeric",
            "title": "Cek pemahaman",
            "prompt": "Garis $y = 3x - 4$ memotong sumbu-y di titik $(0, \\;?)$",
            "answer": "-4",
            "wrong_answers": [
              {
                "value": "4",
                "code": "SIGN_FLIP",
                "message": "Perhatikan tanda di depan 4."
              },
              {
                "value": "3",
                "code": "M_C_SWAP",
                "message": "3 adalah gradien. Titik potong sumbu-y adalah nilai y saat x = 0."
              }
            ],
            "hints": [
              "Di sumbu-y, nilai x selalu 0.",
              "Substitusi x = 0 ke $y = 3x - 4$.",
              "$y = 3(0) - 4 = \\dots$"
            ],
            "solution": "$y = 3(0) - 4 = -4$, jadi titiknya $(0, -4)$."
          }
        ]
      }
    },
    {
      "slug": "u3-contoh",
      "phase": "example",
      "title": "Dari cerita ke persamaan",
      "literacy_processes": [
        "formulate",
        "employ"
      ],
      "indicators": [
        "F3",
        "E2"
      ],
      "content": {
        "steps": [
          {
            "key": "contoh",
            "type": "worked_example",
            "title": "Saya lakukan",
            "prompt": "Sewa sepeda: biaya awal Rp3.000, lalu Rp2.000 per jam. Susun [[model_matematika|model matematikanya]].",
            "lines": [
              {
                "label": "Langkah 1 · Tentukan variabel",
                "tex": "x = \\text{lama sewa (jam)},\\quad y = \\text{biaya (Rp)}"
              },
              {
                "label": "Langkah 2 · Cari yang berubah per satuan",
                "tex": "m = \\hl{2000}",
                "note": "Bertambah Rp2.000 setiap 1 jam → gradien."
              },
              {
                "label": "Langkah 3 · Cari nilai awal",
                "tex": "c = \\hl{3000}",
                "note": "Dibayar walau baru 0 jam → konstanta."
              },
              {
                "label": "Langkah 4 · Tulis model",
                "tex": "y = \\hl{2000}x + \\hl{3000}"
              }
            ]
          },
          {
            "key": "cocokkan",
            "type": "choice",
            "title": "Kita lakukan",
            "prompt": "Parkir: Rp2.000 untuk masuk, lalu Rp1.000 setiap jam. Model yang tepat adalah …",
            "options": [
              {
                "id": "a",
                "text": "$y = 1000x + 2000$"
              },
              {
                "id": "b",
                "text": "$y = 2000x + 1000$",
                "code": "M_C_SWAP",
                "feedback": "Mana yang bertambah setiap jam, dan mana yang nilai awal?"
              },
              {
                "id": "c",
                "text": "$y = 3000x$",
                "feedback": "Biaya masuk hanya dibayar sekali, tidak dikalikan jam."
              }
            ],
            "answer": "a",
            "hints": [
              "Apa yang bertambah setiap jam?",
              "Rp1.000 per jam → $m$. Rp2.000 sekali di awal → $c$.",
              "$y = mx + c$ dengan $m = 1000$ …"
            ],
            "solution": "$m = 1000$ (per jam), $c = 2000$ (biaya masuk): $y = 1000x + 2000$."
          },
          {
            "key": "model-sendiri",
            "type": "linear_model",
            "title": "Kamu lakukan",
            "prompt": "Pulsa Rina tinggal Rp50.000. Setiap hari ia memakai Rp4.000. Susun model sisa pulsa ($y$) setelah $x$ hari.",
            "x_label": "hari",
            "y_label": "sisa pulsa (Rp)",
            "answer": {
              "m": "-4000",
              "c": "50000"
            },
            "hints": [
              "Pulsa bertambah atau berkurang setiap hari?",
              "Berkurang Rp4.000 per hari → $m$ negatif.",
              "Nilai awal Rp50.000 → $c$."
            ],
            "solution": "$y = -4000x + 50000$."
          }
        ]
      }
    },
