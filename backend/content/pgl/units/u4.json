    {
      "slug": "u4-contoh",
      "phase": "example",
      "title": "Dari dua titik ke persamaan",
      "literacy_processes": [
        "employ",
        "evaluate"
      ],
      "indicators": [
        "E1",
        "E2",
        "I2"
      ],
      "content": {
        "steps": [
          {
            "key": "contoh-1",
            "type": "worked_example",
            "title": "Saya lakukan",
            "prompt": "Tentukan persamaan garis yang melalui $(1, 5)$ dan $(3, 9)$.",
            "lines": [
              {
                "label": "Langkah 1 · Cari gradien",
                "tex": "m = \\dfrac{9 - 5}{3 - 1} = \\dfrac{4}{2} = \\hl{2}"
              },
              {
                "label": "Langkah 2 · Pilih satu titik",
                "tex": "(x_1, y_1) = (\\hl{1}, \\hl{5})"
              },
              {
                "label": "Langkah 3 · Masukkan ke rumus",
                "tex": "y - \\hl{5} = \\hl{2}(x - \\hl{1})",
                "note": "Rumus: y − y₁ = m(x − x₁)."
              },
              {
                "label": "Langkah 4 · Kalikan ke dalam kurung",
                "tex": "y - 5 = \\hl{2x - 2}"
              },
              {
                "label": "Langkah 5 · Pindahkan −5 ke kanan",
                "tex": "y = 2x - 2 \\hl{+ 5}"
              },
              {
                "label": "Langkah 6 · Sederhanakan",
                "tex": "y = 2x \\hl{+ 3}"
              },
              {
                "label": "Langkah 7 · Cek balik dengan (3, 9)",
                "tex": "2(3) + 3 = 9 \\ \\checkmark",
                "note": "Titik kedua cocok, jadi persamaannya benar."
              }
            ]
          },
          {
            "key": "contoh-2",
            "type": "worked_example",
            "title": "Kita lakukan",
            "prompt": "Tentukan persamaan garis melalui $(2, 1)$ dan $(4, 7)$. Isi langkah yang kosong.",
            "lines": [
              {
                "label": "Langkah 1 · Cari gradien",
                "tex": "m = \\dfrac{7 - 1}{4 - 2} = \\dfrac{6}{2} = \\hl{3}"
              },
              {
                "label": "Langkah 2 · Masukkan ke rumus",
                "tex": "y - 1 = 3(x - 2)"
              },
              {
                "label": "Langkah 3 · Kalikan ke dalam kurung",
                "tex": "y - 1 = 3x - 6"
              },
              {
                "label": "Langkah 4 · Pindahkan −1 ke kanan. Nilai c =",
                "tex": "y = 3x +",
                "blank": {
                  "answer": "-5",
                  "wrong_answers": [
                    {
                      "value": "-7",
                      "code": "SIGN_FLIP",
                      "message": "Memindahkan −1 ke kanan menjadi +1: −6 + 1 = …"
                    },
                    {
                      "value": "5",
                      "code": "SIGN_FLIP",
                      "message": "Periksa tandanya: −6 + 1 hasilnya negatif."
                    }
                  ]
                }
              },
              {
                "label": "Langkah 5 · Cek balik dengan (4, 7)",
                "tex": "3(4) - 5 = 7 \\ \\checkmark"
              }
            ],
            "hints": [
              "Dari $y - 1 = 3x - 6$, tambahkan 1 ke kedua ruas.",
              "$y = 3x - 6 + 1$",
              "$-6 + 1 = \\dots$"
            ],
            "solution": "$y = 3x - 6 + 1 = 3x - 5$, jadi $c = -5$."
          },
          {
            "key": "latihan-dua-titik",
            "type": "linear_model",
            "title": "Kamu lakukan",
            "prompt": "Tentukan persamaan garis yang melalui $(0, -2)$ dan $(2, 4)$.",
            "answer": {
              "m": "3",
              "c": "-2"
            },
            "hints": [
              "Hitung gradien lebih dulu.",
              "$m = \\dfrac{4 - (-2)}{2 - 0} = \\dfrac{6}{2}$",
              "Titik $(0, -2)$ ada di sumbu-y, jadi $c$ = …"
            ],
            "solution": "$m = 3$, dan karena melalui $(0, -2)$, $c = -2$: $y = 3x - 2$."
          },
          {
            "key": "cek-balik",
            "type": "check_back",
            "title": "Cek balik",
            "prompt": "Cek persamaan $y = 3x - 2$ dengan titik $(2, 4)$: hitung $3(2) - 2$.",
            "answer": "4",
            "hints": [
              "Ganti x dengan 2.",
              "$3 \\times 2 = 6$",
              "$6 - 2 = \\dots$"
            ],
            "solution": "$3(2) - 2 = 4$ ✓ sama dengan y titik (2, 4)."
          },
          {
            "key": "latihan-grafik",
            "type": "read_point",
            "title": "Dari grafik",
            "prompt": "Tulis dua titik yang dilalui garis ini. Langkah berikutnya kamu akan menyusun persamaannya.",
            "line": {
              "m": "-2",
              "c": "3"
            },
            "level": 3,
            "grid": {
              "x_min": -4,
              "x_max": 4,
              "y_min": -5,
              "y_max": 5
            },
            "hints": [
              "Cari titik potong dengan sumbu-y.",
              "Dari titik itu, geser 1 ke kanan: garis turun berapa?",
              "Contoh: $(0, 3)$ dan $(1, 1)$."
            ],
            "solution": "Contoh: $(0, 3)$ dan $(1, 1)$."
          },
          {
            "key": "model-grafik",
            "type": "linear_model",
            "title": "Dari grafik",
            "prompt": "Dari titik yang kamu baca tadi, tulis persamaan garisnya.",
            "answer": {
              "m": "-2",
              "c": "3"
            },
            "hints": [
              "Hitung gradien dari dua titikmu.",
              "Garis turun 2 setiap 1 ke kanan.",
              "Garis memotong sumbu-y di 3."
            ],
            "solution": "$y = -2x + 3$."
          }
        ]
      }
    },
