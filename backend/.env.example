# Salin menjadi .env lalu isi. Jangan commit file .env!
ENV=development
DATABASE_URL=sqlite:///./data/app.db
# Buat dengan: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=ganti-dengan-rahasia-acak
JWT_EXPIRE_MINUTES=480
# Domain frontend produksi, pisahkan dengan koma
CORS_ORIGINS=
LOG_LEVEL=INFO
# Sajikan build frontend dari backend (mode satu layanan); kosongkan bila terpisah
STATIC_DIR=
# AI Gemini — Area Peneliti (ADR-016) & Tanya Gari siswa (ADR-018/021). Buat kunci di https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Dicoba berurutan bila model utama sibuk (503/429)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# Batas "Tanya Gari" per siswa per jam
AI_STUDENT_CALLS_PER_HOUR=20
AI_CALLS_PER_HOUR=60
